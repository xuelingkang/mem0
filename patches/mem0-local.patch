+@app.get("/health", summary="Liveness + backend self-check")
+async def health() -> Dict[str, Any]:
+    """存活 + 后端自证：`backend` 字段固定为 `falkordb`，并顺带探一次图库连通性。"""
+    from graphiti_core.driver.falkordb_driver import FalkorDriver
+
+    backend = "falkordb"
