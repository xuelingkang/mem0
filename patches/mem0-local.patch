+def _dispatch_decay_reinforcement(vector_store, updates: Dict[str, Dict[str, Any]]) -> None:
+    """把强化写入派发到后台线程（设计 §4.3）。
+
+    强化不进入响应时延路径：检索结果先返回，写入在后台线程里补齐；写入失败只记日志，
+    不改变已返回的结果。
+    """
