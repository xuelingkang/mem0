+def _jaccard(left: Iterable[str], right: Iterable[str]) -> float:
+    left_set, right_set = set(left), set(right)
+    if not left_set and not right_set:
+        return 0.0
+    return len(left_set & right_set) / len(left_set | right_set)
+
