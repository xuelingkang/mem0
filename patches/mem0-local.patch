+                            "scope_user_id": scope["user_id"],
+                            "scope_agent_id": scope["agent_id"],
+                            "members": list(cluster["members"]),
+                            "created_at": created_at,
+                            "invalid_at": None,
+                        }
+                        oriented_hashes = orient_result.existing_hashes
