+
+        for scope in selected:
+            scope_report = {**scope, "candidates": 0, "skipped_clusters": 0, "deferred_clusters": 0}
+            if scope["facts"] < settings.min_cluster_size:
+                # O4：事实数不足最小簇规模，本轮跳过该作用域。
+                report["scopes"].append(scope_report)
