+
+    def test_parse_timestamp_accepts_z_suffix_and_rejects_garbage(self):
+        assert _parse_decay_timestamp("2026-09-17T00:00:00Z") == datetime(2026, 9, 17, tzinfo=timezone.utc)
+        assert _parse_decay_timestamp("") is None
