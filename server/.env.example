OPENAI_API_KEY=

# Optional: other bundled LLM/embedder providers (set the key for the one you want to use)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
DASHBOARD_URL=http://localhost:3000
APP_DB_NAME=mem0_app

# Default LLM and embedder models. Provider must be in BUNDLED_*_PROVIDERS
# (see server/main.py). Override to pin a specific model without editing code.
MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# Set to false to opt out.
MEM0_TELEMETRY=true

# Retrieval decay (optional). Unset means the SDK defaults are used; `false` keeps
# retrieval byte-identical to pre-decay releases.
MEM0_DECAY_ENABLED=false
MEM0_DECAY_HALFLIFE_DAYS=
MEM0_DECAY_STRENGTH_STEP_DAYS=
MEM0_DECAY_ACCESS_CAP=
MEM0_DECAY_FLOOR=
MEM0_DECAY_COOLDOWN_SECONDS=

# Dream background synthesis (optional). Off by default: it writes new observation
# records, so it never enables itself during an upgrade. While false, POST /dream/run
# and POST /dream/preview return 409 and no periodic thread is started.
DREAM_ENABLED=false
# Seconds between two periodic runs (default 86400).
DREAM_INTERVAL_SECONDS=
# Delay before the first periodic run (default 1800).
DREAM_INITIAL_DELAY_SECONDS=
# Whole-run timeout; already-written observations survive (default 1800).
DREAM_RUN_TIMEOUT_SECONDS=
# Per-cluster LLM timeout (default 60).
DREAM_PER_CLUSTER_TIMEOUT_SECONDS=
# Where dry-run/live reports are written (default /app/history/dream-reports).
DREAM_REPORT_DIR=

# Graph memory (Graphiti side-car graph, optional). Off by default: no fact is dispatched
# to the graph, no graph query is made and no graph boost is applied, so retrieval stays
# byte-identical to pre-graph releases. The capability degrades silently when the bridge
# or FalkorDB is down (`docker compose up -d falkordb graph-bridge` to bring it up).
MEM0_GRAPH_ENABLED=false
MEM0_GRAPH_ENDPOINT=http://graph-bridge:8000
# Graph boost ceiling W_g (default 0.5, i.e. at most 16.7% of a fully-loaded final score).
MEM0_GRAPH_WEIGHT=
# Facts taken from one graph search (default 10).
MEM0_GRAPH_MAX_FACTS=
# Hard timeout budget for the graph branch of /search, in seconds (default 1.0). Measured
# bridge /search latency (n=100): p50 0.163 / p90 0.445 / p95 0.514 / p99 0.812 / max
# 0.842s, so 0.4s cut off ~14% of normal requests; a timeout is now reported as
# `graph_status: "timeout"` on every search result instead of silently dropping the signal.
MEM0_GRAPH_TIMEOUT_SECONDS=
# Adopt graph facts already invalidated on the graph side (default false).
MEM0_GRAPH_INCLUDE_INVALIDATED=
# Bounded dispatch queue (default 1000); overflow drops the oldest task and counts it.
MEM0_GRAPH_QUEUE_SIZE=
# Per-episode retry budget and linear backoff base (defaults 3 / 5.0s).
MEM0_GRAPH_MAX_RETRIES=
MEM0_GRAPH_RETRY_BACKOFF_SECONDS=
# Circuit breaker: consecutive failures to open, cooldown window (defaults 5 / 60s).
MEM0_GRAPH_CIRCUIT_BREAKER_FAILURES=
MEM0_GRAPH_CIRCUIT_COOLDOWN_SECONDS=
# Single /episodes request timeout on the mem0 side (default 120s; one ingest runs several
# LLM calls and measured 14–37s per fact).
MEM0_GRAPH_REQUEST_TIMEOUT_SECONDS=

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30
